{
  "name": "qrcodeforge",
  "productName": "QR Code Forge",
  "version": "1.1.0",
  "description": "Modern QR code forge: styled dots and gradients, logo/photo/emoji in the middle, WiFi/vCard/WhatsApp payloads, PNG/JPG/SVG export, batch ZIP generation. Ships as a Windows installer and Linux Flatpak/AppImage.",
  "author": "lakisan1",
  "license": "MIT",
  "homepage": "https://github.com/lakisan1/QR-Code-Forge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakisan1/QR-Code-Forge.git"
  },
  "bugs": "https://github.com/lakisan1/QR-Code-Forge/issues",
  "private": true,
  "type": "commonjs",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "vite",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "icons": "node tools/gen-icons.mjs",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis portable",
    "dist:linux": "electron-builder --linux AppImage",
    "flatpak": "bash scripts/build-flatpak.sh"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@zxing/library": "^0.21.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "qr-code-styling": "^1.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
